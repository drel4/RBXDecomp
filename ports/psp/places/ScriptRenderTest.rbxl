<Item class="Script"><Properties><string name="Name">MotionValidation</string><ProtectedString name="Source"><![CDATA[
-- Integration fixture, not the gameplay acceptance map.
local part=script.Parent
local elapsed=0
while true do
    local dt=wait()
    elapsed=elapsed+dt
    part.CFrame=CFrame.new(12*math.sin(elapsed),6,0)*CFrame.Angles(0,elapsed,0)
    part.Transparency=.25+.25*math.sin(elapsed)
end
]]></ProtectedString></Properties></Item></Item>
</Item></roblox>
